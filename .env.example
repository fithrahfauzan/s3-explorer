# Bucket 1: Manual Authentication
BUCKET_1_ID=dev-bucket
BUCKET_1_NAME=my-dev-bucket-123
BUCKET_1_REGION=us-east-1
BUCKET_1_AUTH_TYPE=manual
BUCKET_1_ACCESS_KEY=YOUR_ACCESS_KEY
BUCKET_1_SECRET_KEY=YOUR_SECRET_KEY

# Bucket 2: IRSA (IAM Roles for Service Accounts)
BUCKET_2_ID=prod-bucket
BUCKET_2_NAME=my-prod-bucket-456
BUCKET_2_REGION=us-west-2
BUCKET_2_AUTH_TYPE=irsa

# Only needed if the frontend is served from a different origin than the
# backend (e.g. running the Vite dev server separately without its proxy).
# CORS_ORIGINS=["http://localhost:5173"]

# When true: delete is disabled for every bucket, and the upload flow only
# returns a presigned PUT URL for the user to run manually (e.g. via curl)
# instead of uploading through the browser.
# RESTRICTED_MODE=true

# When set, every /api route except /api/health and /api/auth/* requires a
# session obtained by posting this password to /api/auth/login. Leave unset
# to disable login entirely. Use a long, random value.
#
# Superseded by AUTH_PROFILE_N_PASSWORD below when any are configured — kept
# only as a single-profile fallback (using the global RESTRICTED_MODE above).
# AUTH_PASSWORD=change-me

# Multiple login profiles: each has its own password and its own
# restricted_mode, independent of the global RESTRICTED_MODE and of each
# other. Add as many AUTH_PROFILE_N_* as needed (N = 1, 2, 3, ...). Example:
# one full-access login and one restricted-only login sharing the same app.
# AUTH_PROFILE_1_PASSWORD=change-me-full-access
# AUTH_PROFILE_1_RESTRICTED_MODE=false
# AUTH_PROFILE_2_PASSWORD=change-me-restricted
# AUTH_PROFILE_2_RESTRICTED_MODE=true

# Static API tokens for external / programmatic access. A client sends
#   Authorization: Bearer <token>
# instead of logging in for a session cookie. Each token has its own
# restricted_mode (independent of the global RESTRICTED_MODE and of the
# login profiles). Add as many API_TOKEN_N_* as needed (N = 1, 2, 3, ...).
# Generate values with:  openssl rand -hex 32
# API_TOKEN_1_VALUE=change-me-full-access
# API_TOKEN_1_RESTRICTED_MODE=false
# API_TOKEN_2_VALUE=change-me-restricted
# API_TOKEN_2_RESTRICTED_MODE=true
#
# API_TOKEN (no index) is accepted as a single-token fallback using the
# global RESTRICTED_MODE, mirroring AUTH_PASSWORD.
# API_TOKEN=change-me
#
# NOTE: configuring a token (with no login password) protects every /api
# route the same way a password does. A deployment that serves the web UI
# must still set AUTH_PASSWORD / AUTH_PROFILE_N_PASSWORD — the UI has no way
# to send a Bearer header, so token-only + UI leaves the UI unusable.

# Signs the session cookie. If unset, a random value is generated on every
# process start (all sessions are invalidated on restart, and — important
# if you run more than one backend replica — a cookie signed by one replica
# won't validate on another). Set this explicitly to a long random string
# for any deployment with more than one replica, or to survive restarts.
# SESSION_SECRET=

# Marks the session cookie Secure (HTTPS-only). Defaults to true. Only set
# to false for local development over plain HTTP.
# SESSION_SECURE_COOKIE=false
